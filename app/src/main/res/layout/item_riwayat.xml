<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Exercise Icon Circle -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_red_light">
                <ImageView
                    android:id="@+id/iv_exercise_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_fitness_center"
                    android:tag="ms:fitness_center"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_exercise_type_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Squat"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/tv_session_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="31 Maret 2026, 14:30"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_delete_history"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_x_circle"
                android:tag="ms:cancel"
                app:tint="@color/text_secondary"
                android:padding="8dp"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A000000"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Stats: Reps & Duration -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">
                
                <TextView
                    android:id="@+id/tv_session_reps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 Repetisi"
                    android:textColor="@color/on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:tag="ms-start:bolt"
                    android:drawableStart="@drawable/ic_bolt"
                    android:drawablePadding="6dp"
                    app:drawableTint="@color/primary"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/tv_session_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="02:30"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:tag="ms-start:list_alt"
                    android:drawableStart="@drawable/ic_steps"
                    android:drawablePadding="6dp"
                    app:drawableTint="@color/text_secondary"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_video_availability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_chip_blue_light"
            android:text="Video evaluasi tersedia"
            android:textColor="#1D4ED8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:fontFamily="@font/poppins"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/layout_video_preview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/black"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_video_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:src="@drawable/bicepcurl" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_chip_blue_light"
                android:text="Preview gerakan + skeleton"
                android:textColor="#1D4ED8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

        </FrameLayout>

        <!-- Feedback Section (NEW) -->
        <LinearLayout
            android:id="@+id/layout_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_steps_box"
            android:padding="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_info_circle"
                android:tag="ms:info"
                app:tint="#3B82F6" />

            <TextView
                android:id="@+id/tv_feedback_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Saran: Pastikan pinggul turun lebih rendah lagi."
                android:textColor="#1E40AF"
                android:textSize="11sp"
                android:fontFamily="@font/poppins" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
