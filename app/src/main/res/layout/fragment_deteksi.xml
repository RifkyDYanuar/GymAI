<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/result_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- Skeleton Overlay (Matched with Preview) -->
    <com.modul.gymai.overlay.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="50dp"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_header_gradient_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_exercise_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:text="Deteksi Gerakan"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- FPS"
            android:textColor="#AAFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins" />

    </LinearLayout>

    <!-- Result Panel (bottom) -->
    <LinearLayout
        android:id="@+id/result_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_detection_card"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Label + Confidence Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Label badge -->
            <TextView
                android:id="@+id/tv_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEMUAT..."
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_chip_salah" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Rep Counter -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_reps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REP"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Confidence Bar (Hidden per user request) -->
        <LinearLayout
            android:id="@+id/layout_accuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Akurasi"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <ProgressBar
                android:id="@+id/progress_confidence"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/success"
                android:progressBackgroundTint="#33FFFFFF" />

            <TextView
                android:id="@+id/tv_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Feedback Text -->
        <TextView
            android:id="@+id/tv_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posisikan diri di depan kamera"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_cnn_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="CNN1D TEST: --"
            android:textColor="#8BFFB1"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Stop Button -->
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Selesai"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Floating Camera Switch Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#CC000000"
        app:strokeWidth="1dp"
        app:strokeColor="#40FFFFFF"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/result_panel"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_flip_camera"
            android:tag="ms:cameraswitch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/white"
            android:padding="14dp"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Rules Overlay -->
    <LinearLayout
        android:id="@+id/layout_rules_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E6000000"
        android:padding="32dp"
        android:visibility="gone"
        android:elevation="20dp"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan Evaluasi"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="@font/poppins" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur posisi dulu supaya evaluasi lebih akurat"
            android:textColor="@color/white_70"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <!-- Rule 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_lightbulb"
                    android:tag="ms:lightbulb"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cari tempat yang cukup terang supaya tubuh terlihat jelas."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Rule 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_steps"
                    android:tag="ms:list_alt"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atur jarak sekitar 2,5-3 meter, lalu sesuaikan sampai kepala dan kaki tetap masuk frame."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Rule 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_check_circle"
                    android:tag="ms:check_circle"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pastikan tubuh terlihat utuh dari kepala sampai kaki."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Rule 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_camera_alt"
                    android:tag="ms:camera_alt"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Letakkan HP tegak dan stabil, sebaiknya gunakan tripod atau penyangga saat evaluasi."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Rule 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_check_circle"
                    android:tag="ms:fitness_center"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lakukan gerakan sesuai latihan yang dipilih dan ikuti arahan di layar."
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_rules_countdown"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circle_red_light"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="10"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="40sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_rules_ready_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Panduan evaluasi sedang dibacakan, tunggu sebentar"
            android:textColor="@color/white_60"
            android:textSize="13sp"
            android:gravity="center"
            android:textAlignment="center"
            android:fontFamily="@font/poppins" />

    </LinearLayout>

    <!-- Initializing overlay -->
    <LinearLayout
        android:id="@+id/layout_initializing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/bg_detection_card"
        android:visibility="visible"
        android:elevation="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menginisialisasi kamera..."
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
