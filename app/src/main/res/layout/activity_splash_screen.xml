<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 1: Animated gradient background -->
    <com.modul.gymai.ui.AnimatedGradientView
        android:id="@+id/animated_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 2: Glow pulse behind logo -->
    <View
        android:id="@+id/glow_view"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_gravity="center"
        android:layout_marginBottom="40dp"
        android:alpha="0"
        android:background="@drawable/bg_splash_glow" />

    <!-- Layer 3: Particle sparkle effects -->
    <com.modul.gymai.ui.SplashParticleView
        android:id="@+id/particle_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 4: Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Logo GymPose AI -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/logogympose"
            android:scaleType="fitCenter"
            android:alpha="0"
            android:scaleX="0.2"
            android:scaleY="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="120dp" />

        <!-- App name: typed character by character -->
        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo"
            android:layout_marginTop="4dp" />

        <!-- Tagline: marquee slide from right -->
        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latih Cerdas, Gerak Tepat"
            android:textColor="#BBFFFFFF"
            android:textSize="14sp"
            android:textStyle="italic"
            android:fontFamily="@font/poppins"
            android:letterSpacing="0.04"
            android:alpha="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_name"
            android:layout_marginTop="4dp" />

        <!-- Glow Ring Loading (replaces divider + progress bar) -->
        <com.modul.gymai.ui.GlowRingLoadingView
            android:id="@+id/glow_ring_loader"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_tagline"
            android:layout_marginTop="24dp" />

        <!-- Loading text (inside ring area) -->
        <TextView
            android:id="@+id/tv_loading_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memuat..."
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/poppins"
            android:alpha="0"
            app:layout_constraintStart_toStartOf="@+id/glow_ring_loader"
            app:layout_constraintEnd_toEndOf="@+id/glow_ring_loader"
            app:layout_constraintTop_toTopOf="@+id/glow_ring_loader"
            app:layout_constraintBottom_toBottomOf="@+id/glow_ring_loader" />

        <!-- Copyright -->
        <TextView
            android:id="@+id/tv_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2026 GymPose AI"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/poppins"
            android:alpha="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="28dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>